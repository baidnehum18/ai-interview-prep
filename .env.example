# Copy to .env and edit. Everything is optional.

# Database - MySQL (leave unset to use a local SQLite file):
# DATABASE_URL=mysql+pymysql://interview_user:change_me@localhost:3306/interview_prep

# LLM feedback - any OpenAI-compatible API (leave unset for NLP-only scoring).
# Local Ollama (free):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# Claude:
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-sonnet-5-5
# LLM_API_KEY=your-key
# OpenAI:
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-key

# EMBEDDING_MODEL=all-MiniLM-L6-v2
# WHISPER_MODEL=base
